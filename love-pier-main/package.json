{
  "name": "love-pier-cafe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "WATCHPACK_POLLING=true next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate-points-redemption": "node scripts/apply-points-redemption-migration.mjs --apply",
    "db:migrate-preorder": "node scripts/apply-preorder-migration.mjs --apply",
    "db:migrate-tiers": "node scripts/apply-customer-tiers-migration.mjs --apply",
    "db:migrate-tier-expiry": "node scripts/apply-tier-expiry-migration.mjs --apply",
    "db:migrate-line-friends": "node scripts/apply-line-friends-migration.mjs --apply",
    "db:migrate-preorder-catalog": "node scripts/apply-preorder-catalog-migration.mjs --apply",
    "db:migrate-preorder-descriptions": "node scripts/apply-preorder-descriptions-migration.mjs --apply",
    "db:migrate-tier-catalog": "node scripts/apply-tier-catalog-migration.mjs --apply",
    "db:migrate-group-invites": "node scripts/apply-group-invites-migration.mjs --apply",
    "db:migrate-referrals": "node scripts/apply-referrals-migration.mjs --apply",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env.local lib/db/seed.ts",
    "db:seed-full": "tsx --env-file=.env.local lib/db/seed-full.ts",
    "create-admin": "tsx --env-file=.env.local scripts/create-admin.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.4.0",
    "@line/liff": "^2.26.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "heic2any": "^0.0.4",
    "leaflet": "^1.9.4",
    "lenis": "^1.3.23",
    "lucide-react": "^1.21.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.10",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.80.0",
    "sharp": "^0.35.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tsx": "^4.22.4",
    "vitest": "^4.1.10"
  },
  "//optionalDependencies": "sharp ships its prebuilt binaries as its own optionalDependencies keyed by os/cpu. Vercel builds with `npm install --no-package-lock`, which does not reliably pull those transitive optional platform packages — so the linux-x64 binary was missing and `import sharp` in /api/admin/upload 500'd at module load (a non-JSON error the client could only show as \"Upload failed\"). Declaring the linux glibc x64 pair directly makes them first-class installs. Versions must track `sharp` (see node_modules/sharp/package.json optionalDependencies).",
  "optionalDependencies": {
    "@img/sharp-libvips-linux-x64": "1.3.1",
    "@img/sharp-linux-x64": "0.35.2"
  }
}
